<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — Compose handles the actual theming. -->
    <style name="Theme.TrackOne" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Edge-to-edge: transparent system bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background -->
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <!-- Set the theme to apply after the splash screen finishes -->
        <item name="postSplashScreenTheme">@style/Theme.TrackOne</item>
    </style>
</resources>