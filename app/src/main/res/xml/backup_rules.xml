<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower (API 30 and below).
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices running API 31+, which use
   data_extraction_rules.xml instead.

   Transactions detected in bank SMS never leave the device, so their
   database is excluded. Everything else keeps the platform defaults.
-->
<full-backup-content>
    <exclude domain="database" path="detected_transactions.db" />
    <exclude domain="database" path="detected_transactions.db-journal" />
    <exclude domain="database" path="detected_transactions.db-shm" />
    <exclude domain="database" path="detected_transactions.db-wal" />
</full-backup-content>
